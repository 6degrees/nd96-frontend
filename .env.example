# mock  = MSW intercepts every /api call in the browser (no backend needed)
# live  = real Laravel backend
NEXT_PUBLIC_API_MODE=mock

# poll = 2s polling of GET /api/messages (the default we ship)
# echo = Laravel Echo + Reverb websockets (upgrade, only after it survives
#        an endurance run on the real venue network — spec §4)
NEXT_PUBLIC_TRANSPORT=poll

# Empty when the build is served from Laravel public/app/ (same origin).
NEXT_PUBLIC_API_BASE=https://api.nd96.6degrees.com.sa

# Only needed when NEXT_PUBLIC_TRANSPORT=echo
NEXT_PUBLIC_REVERB_APP_KEY=
NEXT_PUBLIC_REVERB_HOST=
NEXT_PUBLIC_REVERB_PORT=8080

# Mock-only: interval (ms) for the fake event feed on the wall. 0 = off.
NEXT_PUBLIC_MOCK_FEED_MS=6000
